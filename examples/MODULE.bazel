module(name = "rules_steam_examples")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_steam")
local_path_override(
    module_name = "rules_steam",
    path = "..",
)

steam = use_extension("@rules_steam//steam:extensions.bzl", "steam")
steam.app(
    name = "scpsl_dedicated_server",
    app = 996560,
    os = "linux",
    lock_file = "//:scpsl.lock.json",
)
use_repo(steam, "scpsl_dedicated_server")
