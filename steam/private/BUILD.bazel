load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load(":parse_test.bzl", "parse_test")
load(":targets.bzl", "steam_app_targets", "steam_tar")
load(":targets_test.bzl", "overlay_test")

exports_files(["pin.py"])

steam_app_targets(
    name = "empty_app",
    depots = [],
)

steam_tar(
    name = "empty_plain_tar",
    src = ":empty_app",
    compress = "",
)

steam_tar(
    name = "empty_mutated_tar",
    src = ":empty_app",
    group = 1000,
    owner = 1000,
    package_dir = "/opt/empty",
)

overlay_test(
    name = "overlay_test",
    size = "small",
)

parse_test(
    name = "parse_test",
    size = "small",
)

py_library(
    name = "pin_lib",
    srcs = ["pin.py"],
    imports = ["."],
    deps = ["@rules_python//python/runfiles"],
)

py_test(
    name = "pin_test",
    size = "small",
    srcs = ["pin_test.py"],
    python_version = "3.12",
    deps = [":pin_lib"],
)

py_test(
    name = "pin_live_test",
    size = "medium",
    srcs = ["pin_live_test.py"],
    args = [
        "--depotdownloader",
        "$(rlocationpath @depotdownloader//:bin)",
    ],
    data = ["@depotdownloader//:bin"],
    python_version = "3.12",
    tags = [
        "external",
        "manual",
        "requires-network",
    ],
    deps = [":pin_lib"],
)
