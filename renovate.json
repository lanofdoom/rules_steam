{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>kleinpa/renovate-config"],
  "automerge": true,
  "automergeType": "branch",
  "branchConcurrentLimit": 0,
  "dependencyDashboard": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)depotdownloader\\.bzl$/"],
      "matchStrings": [
        "_VERSION\\s*=\\s*\"(?<currentValue>v[^\"]+)\""
      ],
      "depNameTemplate": "lanofdoom/DepotDownloader",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["lanofdoom/DepotDownloader"],
      "ignoreUnstable": false,
      "postUpgradeTasks": {
        "commands": ["python3 tools/update_deps.py depotdownloader {{{newValue}}}"],
        "fileFilters": ["steam/private/depotdownloader.bzl"]
      }
    }
  ]
}
